Improve Binutils compatability with MSVC link.exe

Microsoft's link.exe assumes that import libraries carry null terminator
entries and does not add a terminating null entry when building import
tables. When link.exe inputs only Binutils-created import libraries, it
quietly produces corrupt PE images. This patch makes Bintuils add these
null import entries to satisfy link.exe.

--- a/binutils/dlltool.c
+++ b/binutils/dlltool.c
@@ -2896,6 +2896,22 @@
 
   temp_file_to_remove[TEMP_TAIL_FILE] = TMP_TAIL_S;
 
+  /* An import library must supply the null import descriptor that
+     terminates the import directory table.  GNU ld emits a terminator
+     itself via its linker script, but MSVC link.exe lays out only what
+     import libraries provide, normally the .idata$3 contribution of
+     the __NULL_IMPORT_DESCRIPTOR archive member.  Without these zeros
+     link.exe leaves the descriptor table unterminated, running into
+     whatever .idata$4 data follows.  Extra copies from multiple import
+     libraries are harmless: all .idata$3 input sections sort after all
+     descriptors in .idata$2, so the first terminates the table.  */
+  fprintf (f, "\t.section\t.idata$3\n");
+  fprintf (f, "\t%s\t0\n", ASM_LONG);
+  fprintf (f, "\t%s\t0\n", ASM_LONG);
+  fprintf (f, "\t%s\t0\n", ASM_LONG);
+  fprintf (f, "\t%s\t0\n", ASM_LONG);
+  fprintf (f, "\t%s\t0\n", ASM_LONG);
+
   if (!no_idata4)
     {
       fprintf (f, "\t.section\t.idata$4\n");
--- a/ld/pe-dll.c
+++ b/ld/pe-dll.c
@@ -2221,8 +2221,14 @@
   return abfd;
 }
 
