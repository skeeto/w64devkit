+/* The null entry terminating the import directory table.  GNU ld emits
+   one through its linker script, but MSVC link.exe relies on import
+   libraries to supply it, and without it produces an image with an
+   unterminated import directory.  Every import library head references
+   this symbol, so a link pulls in exactly one copy, and an MSVC import
+   library's definition serves just as well.  The .idata$3 input
+   sections sort after all .idata$2 descriptors.  */
+
 static bfd *
+make_null_import_descriptor (void)
+{
+  FILE *f = fopen (TMP_NULL_S, FOPEN_WT);
+  bfd *abfd;
+
+  if (f == NULL)
+    {
+      fatal (_("failed to open temporary null descriptor file: %s"),
+	     TMP_NULL_S);
+      return NULL;
+    }
+
+  temp_file_to_remove[TEMP_NULL_FILE] = TMP_NULL_S;
+
+  fprintf (f, "\t.section\t.idata$3\n");
+  fprintf (f, "\t%s\t__NULL_IMPORT_DESCRIPTOR\n", ASM_GLOBAL);
+  fprintf (f, "__NULL_IMPORT_DESCRIPTOR:\n");
+  fprintf (f, "\t%s\t0\n\t%s\t0\n\t%s\t0\n\t%s\t0\n\t%s\t0\n",
+	   ASM_LONG, ASM_LONG, ASM_LONG, ASM_LONG, ASM_LONG);
+
+  fclose (f);
+
+  assemble_file (TMP_NULL_S, TMP_NULL_O);
+
+  abfd = bfd_openr (TMP_NULL_O, HOW_BFD_READ_TARGET);
+  if (abfd == NULL)
+    /* xgettext:c-format */
+    fatal (_("failed to open temporary null descriptor file: %s: %s"),
+	   TMP_NULL_O, bfd_get_errmsg ());
+
+  temp_file_to_remove[TEMP_NULL_O_FILE] = TMP_NULL_O;
+  return abfd;
+}
