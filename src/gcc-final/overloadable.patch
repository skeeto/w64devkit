+      for (i = 0; i < viable.length (); i++)
+	if (i != best
+	    && !c_better_candidate_p (r + best * nargs, r + i * nargs, nargs))
+	  {
+	    c_overload_error (loc, fn, viable, true);
+	    return error_mark_node;
+	  }
+      fn = viable[best];
+    }
+
+  /* Usage was deliberately not recorded for the looked-up decl, which
+     need not be the one the call resolves to.  */
+  if (fn != current_function_decl)
+    TREE_USED (fn) = 1;
+  mark_decl_used (fn, false);
+  return fn;
+}
