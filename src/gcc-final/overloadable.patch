+/* Handle an "overloadable" attribute; arguments as in
+   struct attribute_spec.handler.  The C front end lets several
+   functions with this attribute share a name and picks between them by
+   argument type; see c_resolve_overload.  In C++ the attribute is
+   accepted but means nothing, since functions already overload and
+   already get the mangling this attribute asks for.  */
+
+static tree
+handle_overloadable_attribute (tree *node, tree name,
+			       tree args ATTRIBUTE_UNUSED,
+			       int flags ATTRIBUTE_UNUSED, bool *no_add_attrs)
+{
+  if (TREE_CODE (*node) != FUNCTION_DECL)
+    {
+      warning (OPT_Wattributes, "%qE attribute ignored", name);
+      *no_add_attrs = true;
+    }
+  else if (!prototype_p (TREE_TYPE (*node))
+	   && !TYPE_NO_NAMED_ARGS_STDARG_P (TREE_TYPE (*node)))
+    {
+      error ("%qE attribute requires a function prototype", name);
+      *no_add_attrs = true;
+    }
+
+  return NULL_TREE;
+}
+
 /* Handle a "warning" or "error" attribute; arguments as in
    struct attribute_spec.handler.  */
 
