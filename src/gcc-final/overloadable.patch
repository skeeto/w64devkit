+/* True if DECL was declared __attribute__((overloadable)).  */
+
+static bool
+c_overloadable_attr_p (tree decl)
+{
+  return lookup_attribute ("overloadable", DECL_ATTRIBUTES (decl)) != NULL_TREE;
+}
+
+/* True if X, which is being pushed, and the binding B might belong to
+   the same overload set.  This is the guard on every overloading path
+   in pushdecl, so it is deliberately two bit tests.  */
+
+static bool
+c_overload_involved_p (tree x, struct c_binding *b)
+{
+  if (TREE_CODE (x) != FUNCTION_DECL)
+    return false;
+  return (C_DECL_OVERLOADABLE_P (x)
+	  || (TREE_CODE (b->decl) == FUNCTION_DECL
+	      && C_DECL_OVERLOADABLE_P (b->decl)));
+}
+
+/* True if the binding P is another overload of X rather than a
+   declaration of the same function, so that the walks in pushdecl that
+   look for a previous declaration must step over it.  */
+
+static bool
+c_overload_skip_binding_p (tree x, struct c_binding *p)
+{
+  return (TREE_CODE (p->decl) == FUNCTION_DECL
+	  && !DECL_IS_UNDECLARED_BUILTIN (p->decl)
+	  && c_overload_involved_p (x, p)
+	  && !c_parm_lists_compatible_p (TREE_TYPE (x), TREE_TYPE (p->decl)));
+}
+
+/* X is a FUNCTION_DECL about to be pushed into SCOPE and B is the
+   innermost binding of its name.  Return the binding that X redeclares,
+   which may be in an outer or in the external scope, or NULL if X opens
+   or extends an overload set instead.  Diagnose a redeclaration that
+   disagrees about the attribute, and a second member of a set that
+   lacks it.  Mark every member of the resulting set, including the
+   unmarked one, so that a call can find them all.  */
+
+static struct c_binding *
+c_overload_resolve_decl (tree x, struct c_binding *b, struct c_scope *scope)
+{
+  location_t loc = DECL_SOURCE_LOCATION (x);
+  struct c_binding *p;
+  tree unmarked;
+
+  /* A binding of this name in SCOPE that is not a function at all is an
+     ordinary conflict, not an overload; leave it to pushdecl to report
+     the redeclaration as a different kind of symbol.  */
+  for (p = b; p && B_IN_SCOPE (p, scope); p = p->shadowed)
+    if (TREE_CODE (p->decl) != FUNCTION_DECL)
+      return p;
+
+  /* A built-in the program has not declared cannot be overloaded: it is
+     not a declaration the program made, and a declaration that
+     conflicts with one is the ordinary case of a program replacing a
+     built-in, which pushdecl already handles and diagnoses.  So do
+     nothing until the program has declared something itself.  */
+  for (p = b; p; p = p->shadowed)
+    if (TREE_CODE (p->decl) == FUNCTION_DECL
+	&& !DECL_IS_UNDECLARED_BUILTIN (p->decl))
+      break;
+  if (p == NULL)
+    return b;
+
+  /* Does X redeclare something?  Two functions of the same name are
+     declarations of the same function exactly when their parameter
+     lists are compatible; a difference in the return type is then a
+     conflict, diagnosed as usual by duplicate_decls.  The match may be
+     in an outer or in the external scope, in which case the ordinary
+     cross-scope machinery in pushdecl still has to run.  */
+  for (p = b; p; p = p->shadowed)
+    if (TREE_CODE (p->decl) == FUNCTION_DECL
+	&& c_parm_lists_compatible_p (TREE_TYPE (x), TREE_TYPE (p->decl)))
+      {
+	if (c_overloadable_attr_p (x) != c_overloadable_attr_p (p->decl))
+	  {
+	    auto_diagnostic_group d;
+	    error_at (loc, "redeclaration of %qD differs in the "
+		      "%<overloadable%> attribute", x);
+	    inform (DECL_SOURCE_LOCATION (p->decl),
+		    "previous declaration of %qD", p->decl);
+	  }
+	return p;
+      }
+
+  /* X is a new member of the set formed by the bindings of this name in
+     SCOPE.  At most one member may lack the attribute, and that one
+     keeps its unmangled name.  */
+  unmarked = c_overloadable_attr_p (x) ? NULL_TREE : x;
+  for (p = b; p && B_IN_SCOPE (p, scope); p = p->shadowed)
+    if (TREE_CODE (p->decl) == FUNCTION_DECL)
+      {
+	if (!c_overloadable_attr_p (p->decl))
+	  {
+	    if (unmarked)
+	      {
+		auto_diagnostic_group d;
+		error_at (loc, "more than one declaration of %qD lacks the "
+			  "%<overloadable%> attribute", x);
+		inform (DECL_SOURCE_LOCATION (p->decl),
+			"previous declaration of %qD", p->decl);
+	      }
+	    unmarked = p->decl;
+	  }
+	C_DECL_OVERLOADABLE_P (p->decl) = 1;
+      }
+  C_DECL_OVERLOADABLE_P (x) = 1;
+  return NULL;
+}
+
+/* Collect into CANDS every function that the name ID denotes.  A name
+   can have several bindings in one scope only through the overloadable
+   attribute; bind keeps the shadowed chain sorted by non-increasing
+   depth, so the bindings of the innermost scope that declares ID are
+   consecutive at the head of that chain.  */
+
+void
+c_overload_candidates (tree id, vec<tree> *cands)
+{
+  struct c_binding *b = I_SYMBOL_BINDING (id);
+  unsigned int depth;
+
+  if (!b)
+    return;
+  depth = b->depth;
+  for (; b && b->depth == depth; b = b->shadowed)
+    if (!b->invisible && TREE_CODE (b->decl) == FUNCTION_DECL)
+      cands->safe_push (b->decl);
+  /* The chain runs newest first; report them as they were written.  */
+  cands->reverse ();
+}
