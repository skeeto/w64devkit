+/* If DECL is declared __attribute__((overloadable)), mark it as taking
+   part in overload resolution.  This has to happen before pushdecl,
+   which needs to know whether DECL may share its name with others.  */
+
+static void
+c_mark_overloadable (tree decl)
+{
+  if (TREE_CODE (decl) == FUNCTION_DECL
+      && lookup_attribute ("overloadable", DECL_ATTRIBUTES (decl)))
+    C_DECL_OVERLOADABLE_P (decl) = 1;
+}
+
+/* Give DECL, an overloadable function, an Itanium ABI mangled assembler
+   name, since it shares its source name with the rest of its overload
+   set.  A name the user asked for with asm ("name"), or one
+   multiversioning has already claimed, wins, so this runs late enough
+   to see it.  */
+
+static void
+c_mangle_overloadable (tree decl)
+{
+  tree id;
+
+  if (TREE_CODE (decl) != FUNCTION_DECL
+      || !lookup_attribute ("overloadable", DECL_ATTRIBUTES (decl))
+      || DECL_ASSEMBLER_NAME_SET_P (decl))
+    return;
+
+  id = c_mangle_overloadable_decl (decl);
+  if (id == NULL_TREE)
+    {
+      sorry_at (DECL_SOURCE_LOCATION (decl),
+		"cannot mangle %<overloadable%> function %qD", decl);
+      return;
+    }
+  SET_DECL_ASSEMBLER_NAME (decl, targetm.mangle_decl_assembler_name (decl, id));
+}
