+/* Functions declared __attribute__((overloadable)) share a source name,
+   so they need distinct assembler names.  This produces the same Itanium
+   ABI mangling the C++ front end produces for the same signature, which
+   is also what Clang produces for its "overloadable" attribute.
+
+   cp/mangle.cc cannot be reused here.  It is a cc1plus-only object, it
+   includes cp-tree.h, and it needs the C++ garbage collection roots.
+   Worse, it would be silently wrong: TYPE_LANG_SLOT_1 is
+   TYPE_RAISES_EXCEPTIONS in cp/cp-tree.h but TYPE_ACTUAL_ARG_TYPES in
+   c/c-tree.h, so write_function_type would hand a C argument type list
+   to write_exception_spec.  Only the subset of types C can express is
+   needed, so mangle them here instead.  The writers below follow their
+   cp/mangle.cc counterparts, minus everything only a C++ type can
+   reach, and every gcc_unreachable becomes a soft failure: a parameter
+   type that cannot be mangled is reported with sorry, never an ICE.  */
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "target.h"
+#include "c-tree.h"
+#include "stringpool.h"
+
+/* State for one mangling.  Both vectors are stack allocated, so this
+   file needs no garbage collection roots.  */
+
+struct c_mangle_state
+{
+  auto_vec<char, 64> out;	/* The mangled name being built.  */
+  auto_vec<tree, 16> subs;	/* Substitution candidates, in order.  */
+  bool failed;			/* A type could not be mangled.  */
+};
+
+static void write_type (c_mangle_state *, tree);
+static void write_parm_types (c_mangle_state *, tree);
+
+/* Single letter codes for the builtin integer types, indexed by
+   integer_type_kind values, as in cp/mangle.cc.  */
+
+static const char integer_type_codes[itk_none] =
+{
+  'c',  /* itk_char */
+  'a',  /* itk_signed_char */
+  'h',  /* itk_unsigned_char */
+  's',  /* itk_short */
+  't',  /* itk_unsigned_short */
+  'i',  /* itk_int */
+  'j',  /* itk_unsigned_int */
+  'l',  /* itk_long */
+  'm',  /* itk_unsigned_long */
+  'x',  /* itk_long_long */
+  'y',  /* itk_unsigned_long_long */
+  /* __intN types are handled separately */
+  '\0', '\0', '\0', '\0', '\0', '\0', '\0', '\0'
+};
+
+static void
+write_char (c_mangle_state *s, char c)
+{
+  s->out.safe_push (c);
+}
+
+static void
+write_string (c_mangle_state *s, const char *str)
+{
+  for (; *str; str++)
+    s->out.safe_push (*str);
+}
+
+/* Write VALUE in base 10, as <number> without a sign.  */
+
+static void
+write_unsigned_number (c_mangle_state *s, unsigned HOST_WIDE_INT value)
+{
+  char buf[32];
+  int i = 0;
+
+  do
+    {
+      buf[i++] = '0' + (int) (value % 10);
+      value /= 10;
+    }
+  while (value);
+  while (i)
+    write_char (s, buf[--i]);
+}
+
+/* Write VALUE in base 36 with digits 0-9 and A-Z, as <seq-id>.  */
+
+static void
+write_seq_id (c_mangle_state *s, unsigned HOST_WIDE_INT value)
+{
+  char buf[16];
+  int i = 0;
+
+  do
+    {
+      unsigned digit = (unsigned) (value % 36);
+      buf[i++] = digit < 10 ? '0' + digit : 'A' + digit - 10;
+      value /= 36;
+    }
+  while (value);
+  while (i)
+    write_char (s, buf[--i]);
+}
+
+/* <source-name> ::= </length/ number> <identifier>  */
+
+static void
+write_source_name (c_mangle_state *s, tree id)
+{
+  write_unsigned_number (s, IDENTIFIER_LENGTH (id));
+  write_string (s, IDENTIFIER_POINTER (id));
+}
+
+/* If TYPE has already been mangled, write a reference to it and return
+   true.  Types are compared by identity: C types are hashed, and a
+   typedef shares its main variant's node, so this is both sufficient
+   and cheap.  It also keeps an enumerated type distinct from the
+   integer type it is compatible with, which comptypes would not.  */
+
+static bool
+find_substitution (c_mangle_state *s, tree type)
+{
+  unsigned int i;
+  tree t;
+
+  FOR_EACH_VEC_ELT (s->subs, i, t)
+    if (t == type)
+      {
+	write_char (s, 'S');
+	if (i > 0)
+	  write_seq_id (s, i - 1);
+	write_char (s, '_');
+	return true;
+      }
+  return false;
+}
+
+static void
+add_substitution (c_mangle_state *s, tree type)
+{
+  s->subs.safe_push (type);
+}
+
+/* <builtin-type>.  Unlike the C++ front end's version this does not
+   look for wchar_t, char8_t, char16_t or char32_t: in C those names are
+   typedefs for ordinary integer types, and testing for them would
+   mangle, say, a plain unsigned short as 'w'.  */
+
+static void
+write_builtin_type (c_mangle_state *s, tree type)
+{
+  if (TYPE_CANONICAL (type))
+    type = TYPE_CANONICAL (type);
+
+  switch (TREE_CODE (type))
+    {
+    case VOID_TYPE:
+      write_char (s, 'v');
+      break;
+
+    case BOOLEAN_TYPE:
+      write_char (s, 'b');
+      break;
+
+    case INTEGER_TYPE:
+      {
+	size_t itk;
+      iagain:
+	for (itk = 0; itk < itk_none; ++itk)
+	  if (integer_types[itk] != NULL_TREE
+	      && integer_type_codes[itk] != '\0'
+	      && type == integer_types[itk])
+	    {
+	      write_char (s, integer_type_codes[itk]);
+	      break;
+	    }
+
+	if (itk == itk_none)
+	  {
+	    tree t = c_common_type_for_mode (TYPE_MODE (type),
+					     TYPE_UNSIGNED (type));
+	    if (t != NULL_TREE && type != t)
+	      {
+		type = t;
+		goto iagain;
+	      }
+
+	    if (TYPE_PRECISION (type) == 128)
+	      write_char (s, TYPE_UNSIGNED (type) ? 'o' : 'n');
+	    else
+	      {
+		/* A type that is not one of the shared nodes, such as an
+		   __attribute__((mode(...))) integer.  Write a vendor
+		   extended builtin type named intN or uintN.  */
+		const char *prefix = TYPE_UNSIGNED (type) ? "uint" : "int";
+		char prec[11];
+
+		sprintf (prec, "%u", (unsigned) TYPE_PRECISION (type));
+		write_char (s, 'u');
+		write_unsigned_number (s, strlen (prefix) + strlen (prec));
+		write_string (s, prefix);
+		write_string (s, prec);
+	      }
+	  }
+      }
+      break;
+
+    case REAL_TYPE:
+      if (type == float_type_node)
+	write_char (s, 'f');
+      else if (type == double_type_node)
+	write_char (s, 'd');
+      else if (type == long_double_type_node)
+	write_char (s, 'e');
+      else if (type == dfloat32_type_node)
+	write_string (s, "Df");
+      else if (type == dfloat64_type_node)
+	write_string (s, "Dd");
+      else if (type == dfloat128_type_node)
+	write_string (s, "De");
+      else if (type == float16_type_node)
