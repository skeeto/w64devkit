--- a/src/os_win32.c
+++ b/src/os_win32.c
@@ -7164,6 +7164,69 @@ kit_shell(void)
     return path;
 }
 
+#if defined(FEAT_GUI_MSWIN) || defined(PROTO)
+/*
+ * Start a copy of this process with "-f" after the program name, so that
+ * it stays, and exit.  The copy leaves any job object, as a forked child
+ * on Unix leaves the shell.  Returns only if the copy could not start, so
+ * that this process carries on instead.
+ */
+    void
+mch_gui_detach(void)
+{
+    WCHAR		*line = GetCommandLineW();
+    WCHAR		*rest = line;
+    WCHAR		*cmd;
+    size_t		len;
+    STARTUPINFOW	si;
+    PROCESS_INFORMATION pi;
+    DWORD		flags = CREATE_BREAKAWAY_FROM_JOB;
+    BOOL		ok;
+
+    // The program name ends at the closing quote or the first blank.
+    if (*rest == L'"')
+    {
+	for (++rest; *rest != NUL && *rest != L'"'; ++rest)
+	    ;
+	if (*rest == L'"')
+	    ++rest;
+    }
+    else
+	while (*rest != NUL && *rest != L' ' && *rest != L'\t')
+	    ++rest;
+
+    len = wcslen(line) + 4;
+    cmd = malloc(len * sizeof(WCHAR));
+    if (cmd == NULL)
+	return;
+    wcsncpy(cmd, line, rest - line);
+    cmd[rest - line] = NUL;
+    wcscat(cmd, L" -f");
+    wcscat(cmd, rest);
+
+    // Pass on the window state and standard handles this process got.
+    GetStartupInfoW(&si);
+    si.lpReserved = NULL;
+    si.cbReserved2 = 0;
+    si.lpReserved2 = NULL;
+
+    ok = CreateProcessW(NULL, cmd, NULL, NULL, TRUE, flags, NULL, NULL,
+								    &si, &pi);
+    if (!ok && GetLastError() == ERROR_ACCESS_DENIED)
+	// The job does not allow breaking away, stay in it.
+	ok = CreateProcessW(NULL, cmd, NULL, NULL, TRUE, 0, NULL, NULL,
+								    &si, &pi);
+    free(cmd);
+    if (!ok)
+	return;
+    // Let the copy's window come to the front, as this one's would.
+    AllowSetForegroundWindow(pi.dwProcessId);
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    ExitProcess(0);
+}
+#endif
