+/*
+ * Given a command wrapped in double quotes, return it as one argument by
+ * the C runtime rules: the same quotes around it, a backslash before each
+ * quote inside, and doubled backslashes where they precede a quote.
+ * Returns NULL, in allocated memory otherwise, when "cmd" is not wrapped.
+ */
+    static char_u *
+crt_requote(char_u *cmd)
+{
+    size_t	len = STRLEN(cmd);
+    size_t	i;
+    int		nslash = 0;
+    char_u	*buf, *d;
+
+    if (len < 2 || cmd[0] != '"' || cmd[len - 1] != '"')
+	return NULL;
+    buf = alloc(len * 2 + 1);	// worst case: every byte becomes two
+    if (buf == NULL)
+	return NULL;
+    d = buf;
+    *d++ = '"';
+    for (i = 1; i < len - 1; ++i)
+    {
+	if (cmd[i] == '\\')
+	    ++nslash;
+	else
+	{
+	    if (cmd[i] == '"')
+	    {
+		// double the backslashes before it, and escape it
+		for (; nslash > 0; --nslash)
+		    *d++ = '\\';
+		*d++ = '\\';
+	    }
+	    nslash = 0;
+	}
+	*d++ = cmd[i];
+    }
+    // double the backslashes before the closing quote
+    for (; nslash > 0; --nslash)
+	*d++ = '\\';
+    *d++ = '"';
+    *d = NUL;
+    return buf;
+}
+
