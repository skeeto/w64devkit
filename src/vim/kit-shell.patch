+/*
+ * Get the w64devkit shell, bin\sh.exe in the kit, whose share\vim holds
+ * this executable.  Returns NULL when there is no such file.
+ */
+    char *
+kit_shell(void)
+{
+    static char	path[MAX_PATH * 3];
+    WCHAR	exe[MAX_PATH + 16];
+    WCHAR	full[MAX_PATH];
+    WCHAR	*tail;
+    DWORD	len, attr;
+
+    len = GetModuleFileNameW(NULL, exe, MAX_PATH);
+    if (len == 0 || len >= MAX_PATH)
+	return NULL;
+    tail = wcsrchr(exe, L'\\');
+    if (tail == NULL)
+	return NULL;
+    wcscpy(tail + 1, L"..\\..\\bin\\sh.exe");
+    len = GetFullPathNameW(exe, MAX_PATH, full, NULL);
+    if (len == 0 || len >= MAX_PATH)
+	return NULL;
+    attr = GetFileAttributesW(full);
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY))
+	return NULL;
+    // 'encoding' is not set yet, and defaults to utf-8
+    if (!WideCharToMultiByte(CP_UTF8, 0, full, -1, path, sizeof(path),
+								  NULL, NULL))
+	return NULL;
+    return path;
+}
+
+/*
+ * Return TRUE when 'shell' is a Unix-like shell, such as sh or bash, that
+ * splits its command line by the C runtime rules and takes "\" as an
+ * escape.  PowerShell, which also has "sh" in its name, is not one.
+ */
+    int
+sh_like_shell(void)
+{
+    char *tail = (char *)gettail(p_sh);
+
+    return strstr(tail, "sh") != NULL
+	&& strstr(tail, "powershell") == NULL
+	&& strstr(tail, "pwsh") == NULL;
+}
