Look up iconv encoding names in the alias table before parsing numbers.
name_to_codepage() read any name beginning with "cp" or a digit as a
code page number before it searched the alias table, so the aliases
that begin with "cp" but are not "cp" followed by their own code page
never matched: CP367 and CP819 meant code pages 367 and 819 rather than
20127 and 1252, cp1025 meant 1025 rather than 21025, and CP-IS and
CP-GR meant 0 rather than 861 and 869, all of which iconv_open()
rejects. The number was also read with atoi(), so text after the
digits was ignored and CP850x was taken as 850. Search the aliases
first, and accept a number only if the rest of the name is all digits.

---
 miscutils/iconv.c |   12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

--- a/miscutils/iconv.c
+++ b/miscutils/iconv.c
@@ -914,12 +914,6 @@
 		return GetACP();
 	else if (strcmp(name, "wchar_t") == 0)
 		return 1200;
-	else if (_strnicmp(name, "cp", 2) == 0)
-		return atoi(name + 2); /* CP123 */
-	else if ('0' <= name[0] && name[0] <= '9')
-		return atoi(name);     /* 123 */
-	else if (_strnicmp(name, "xx", 2) == 0)
-		return atoi(name + 2); /* XX123 for debug */
 
 	i = 0;
 	alias = cp_alias;
@@ -930,7 +924,11 @@
 		alias += strlen(alias) + 1;
 		++i;
 	}
-	return -1;
+
+	if (_strnicmp(name, "cp", 2) == 0 || _strnicmp(name, "xx", 2) == 0)
+		name += 2; /* CP123, or XX123 for debug */
+	i = bb_strtou(name, NULL, 10); /* 123 */
+	return errno ? -1 : i;
 }
 
