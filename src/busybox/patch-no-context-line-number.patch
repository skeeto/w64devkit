 		while (plist && *plist->data == "+-"[reverse]) {
@@ -271,8 +307,7 @@
 					TT.hunknum, TT.linenum);
 
 			// File ended before we found a place for this hunk.
-			fail_hunk();
-			goto done;
+			goto fail;
 		}
 
 		if (PATCH_DEBUG) fdprintf(2, "IN: %s\n", data);
@@ -340,6 +375,9 @@
 	dlist_free(TT.current_hunk, do_line);
 	TT.current_hunk = NULL;
 	TT.state = 1;
+	goto done;
+fail:
+	fail_hunk();
 done:
