patch: apply a hunk with no context lines at the line it names.
A hunk with no context lines, as "diff -U0" writes for every change,
gives patch nothing to search for. patch took any hunk without trailing
context to belong at the end of the file, so it added the lines of such
a hunk at the end of the file wherever its header placed them, and
removed lines only if the file happened to end with them, which could
be the wrong copy. A hunk that only removes lines did nothing at all:
apply_one_hunk() skipped the search when the range the hunk leaves
behind was empty, so the lines stayed and patch reported success.

Locate a hunk with no context at either end by the line number in its
header: copy the lines before it, check that its removed lines come
next, and fail the hunk otherwise. Drop the test of the range, which
only ever skipped such hunks.

---
 editors/patch.c       |   56 +++++++++++++++++++++++++++++++++++++++++---------
 testsuite/patch.tests |   30 ++++++++++++++++++++++++++
 2 files changed, 77 insertions(+), 9 deletions(-)

--- a/editors/patch.c
+++ b/editors/patch.c
@@ -203,9 +203,18 @@
 	TT.state = 0;
 }
 
+// Read the next line of the file being patched.
+static char *read_line(void)
+{
+	TT.linenum++;
+//FIXME: this performs 1-byte reads:
+	return xmalloc_reads(TT.filein, NULL);
+}
+
 // Given a hunk of a unified diff, make the appropriate change to the file.
-// This does not use the location information, but instead treats a hunk
-// as a sort of regex.  Copies data from input to output until it finds
+// This does not use the location information (except for a hunk with no
+// context lines), but instead treats a hunk as a sort of regex.  Copies
+// data from input to output until it finds
 // the change to be made, then outputs the changed data and returns.
 // (Finding EOF first is an error.)  This is a single pass operation, so
 // multiple hunks must occur in order in the file.
@@ -228,6 +237,36 @@
 		else matcheof = 0;
 		if (PATCH_DEBUG) fdprintf(2, "HUNK:%s\n", plist->data);
 	}
+
+	// A hunk with no context lines at either end, as "diff -U0" writes,
+	// has nothing to search for, so apply it at the line its header gives:
+	// copy the lines before that one, and match the rest of the hunk there.
+	if (!matcheof && !TT.context) {
+		long before = reverse ? TT.newline - !!TT.newlen
+				: TT.oldline - !!TT.oldlen;
+		char *data;
+
+		if (TT.linenum > before)
+			goto fail;
+		while (TT.linenum < before) {
+			data = read_line();
+			if (!data)
+				goto fail;
+			fdprintf(TT.fileout, "%s\n", data);
+			free(data);
+		}
+		for (plist = TT.current_hunk; plist; plist = plist->next) {
+			if (*plist->data == "+-"[reverse])
+				continue;
+			data = read_line();
+			if (!data || strcmp(data, plist->data+1) != 0) {
+				free(data);
+				goto fail;
+			}
+			free(data);
+		}
+		goto out;
+	}
 	matcheof = !matcheof || matcheof < TT.context;
 
 	if (PATCH_DEBUG) fdprintf(2,"MATCHEOF=%c\n", matcheof ? 'Y' : 'N');
@@ -237,12 +276,9 @@
 	// complete hunk.
 	plist = TT.current_hunk;
 	buf = NULL;
-	if (reverse ? TT.oldlen : TT.newlen) for (;;) {
-//FIXME: this performs 1-byte reads:
-		char *data = xmalloc_reads(TT.filein, NULL);
+	for (;;) {
