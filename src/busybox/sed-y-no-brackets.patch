- *  Returns the index of the third delimiter
+ *  Returns the index of the third delimiter.
+ *  Only if regex is set (s, not y) can the match string have a bracket
+ *  expression, inside which the delimiter does not end it.
  */
-static int parse_regex_delim(const char *cmdstr, char **match, char **replace)
+static int parse_regex_delim(const char *cmdstr, char **match, char **replace, int regex)
 {
 	const char *cmdstr_ptr = cmdstr;
 	unsigned char delimiter;
@@ -378,7 +380,7 @@
 	delimiter = *cmdstr_ptr++;
 
 	/* save the match string */
-	idx = index_of_next_unescaped_regexp_delim(delimiter, cmdstr_ptr);
+	idx = index_of_next_unescaped_regexp_delim(regex ? delimiter : - (int)delimiter, cmdstr_ptr);
 	*match = copy_parsing_escapes(cmdstr_ptr, idx, delimiter);
 	/* save the replacement string */
 	cmdstr_ptr += idx + 1;
@@ -464,7 +466,7 @@
 	 *    ||     |        |||
 	 *    mandatory       optional
 	 */
-	idx = parse_regex_delim(substr, &match, &sed_cmd->string);
+	idx = parse_regex_delim(substr, &match, &sed_cmd->string, 1);
 
 	/* determine the number of back references in the match string */
 	/* Note: we compute this here rather than in the do_subst_command()
@@ -639,7 +641,7 @@
 		char *match, *replace;
 		int i = cmdstr[0];
 
-		cmdstr += parse_regex_delim(cmdstr, &match, &replace)+1;
+		cmdstr += parse_regex_delim(cmdstr, &match, &replace, 0)+1;
 		/* \n already parsed, but \delimiter needs unescaping. */
