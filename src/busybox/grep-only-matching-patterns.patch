+/* Find the first occurrence of the fixed string at or after line[start]
+ * which -w accepts, and set *so and *eo to its offsets in the line.
+ * Returns 0 on a match. */
+static int find_fixed(grep_list_data_t *gl, char *line, unsigned start,
+		unsigned *so, unsigned *eo)
+{
+	unsigned len = strlen(gl->pattern);
+	char *str = line + start;
+
+	for (;;) {
+		char *match = (option_mask32 & OPT_i)
+			? strcasestr(str, gl->pattern)
+			: strstr(str, gl->pattern);
+		if (!match)
+			return 1;
+		if (option_mask32 & OPT_w) {
+			/* skip a match which is not a whole word */
+			char c = (match != line) ? match[-1] : ' ';
+			char d = match[len];
+			if (isalnum(c) || c == '_' || isalnum(d) || d == '_') {
+				if (*match == '\0')
+					return 1;
+				str = match + 1;
+				continue;
+			}
+		}
+		*so = match - line;
+		*eo = *so + len;
+		return 0;
+	}
+}
