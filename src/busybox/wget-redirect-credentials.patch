Do not send credentials to another server after a redirect.
The user and password from the URL, and Authorization and Cookie headers
given with --header, were sent again after a redirect to any URL, so a
server could collect them by redirecting to a host of its choosing. Keep
sending them only while each redirect stays on the same protocol and
host, including any port, with the host compared without regard to case.
Once a redirect leaves it, they are not sent again for that URL, even
after a redirect back. A user and password in the Location URL itself
are still used, and other --header lines are still sent.

---
 networking/wget.c |   35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

--- a/networking/wget.c
+++ b/networking/wget.c
@@ -1187,6 +1187,7 @@
 	FILE *dfp;                      /* socket to ftp server (data)      */
 	char *fname_out_alloc;
 	char *redirected_path = NULL;
+	IF_FEATURE_WGET_LONG_OPTIONS(smallint other_server = 0;)
 	struct host_info server;
 	struct host_info target;
 
@@ -1348,8 +1349,22 @@
 
 #if ENABLE_FEATURE_WGET_LONG_OPTIONS
 		if (G.extra_headers) {
+			const char *hdr = G.extra_headers;
+
 			log_io(G.extra_headers);
-			fputs(G.extra_headers, sfp);
+			while (*hdr) {
+				/* Each header ends in "\r\n" */
+				const char *next = strchr(hdr, '\n') + 1;
+
+				/* Send credentials only to the same server */
+				if (!other_server
+				 || (strncasecmp(hdr, "Authorization:", 14) != 0
+				  && strncasecmp(hdr, "Cookie:", 7) != 0)
+				) {
+					fwrite(hdr, 1, next - hdr, sfp);
+				}
+				hdr = next;
+			}
 		}
 
 		if (option_mask32 & WGET_OPT_POST_FILE) {
@@ -1532,7 +1547,25 @@
 					target.path = redirected_path = xstrdup(str + 1);
 					/* lsa stays the same: it's on the same server */
 				} else {
+					const char *old_protocol = target.protocol;
+					char *old_host = xstrdup(target.host);
+					char *old_user = target.user;
+
+					target.user = NULL;
 					parse_url(str, &target);
+					/* Send credentials only to the same server */
+					if (target.protocol == old_protocol
+					 && strcasecmp(target.host, old_host) == 0
+					) {
+						if (!target.user) {
+							target.user = old_user;
+							old_user = NULL;
+						}
+					} else {
+						IF_FEATURE_WGET_LONG_OPTIONS(other_server = 1;)
+					}
+					free(old_user);
+					free(old_host);
 					if (!use_proxy) {
 						/* server.user remains untouched */
 						free(server.allocated);
