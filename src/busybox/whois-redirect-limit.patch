Limit the number of whois redirects.
Only a redirect to the server just asked was ignored, so two servers
that referred to each other made whois query them in turn forever.
Follow at most 10 redirects, and treat the reply of the last server
asked as having no referral, so it is shown.

---
 networking/whois.c |   12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

--- a/networking/whois.c
+++ b/networking/whois.c
@@ -30,9 +30,11 @@
 
 enum {
 	OPT_i = (1 << 0),
+	MAX_REDIRECTS = 10,
 };
 
-static char *query(const char *host, int port, const char *domain)
+static char *query(const char *host, int port, const char *domain,
+		bool no_redir)
 {
 	int fd;
 	FILE *fp;
@@ -117,8 +119,8 @@
 	}
 
 	/* Success */
-	if (redir && strcmp(redir, host) == 0) {
-		/* Redirect to self does not count */
+	if (redir && (no_redir || strcmp(redir, host) == 0)) {
+		/* Redirect to self (or past the limit) does not count */
 		free(redir);
 		redir = NULL;
 	}
@@ -134,8 +136,10 @@
 {
 	char *free_me = NULL;
 	char *redir;
+	unsigned count = 0;
  again:
-	redir = query(host, port, domain);
+	/* Servers which refer to each other would loop forever */
+	redir = query(host, port, domain, ++count > MAX_REDIRECTS);
 	free(free_me);
 	if (redir) {
 		printf("[Redirected to %s]\n", redir);
