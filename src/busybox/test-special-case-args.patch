Make test parse what its special cases leave of a short expression.
For up to four arguments, test_main2 strips a leading "!" and unwraps
"( x y )" as POSIX describes, but when the result was not one of the
cases it settles itself, the general parser started again from the
original arguments. It thus lost the 4-argument rule that "!" negates
the whole three-argument test, so "test ! '' -a ''" was (! '') -a ''
and false, where POSIX and coreutils give true. Worse, the unwrapping
had already cut the ")" from the argument list, so "test ( -n x )" and
"test ! ( -d dir )" failed with "closing paren expected". Now the parser
starts from the arguments that are left and applies the negation, and
with five or more arguments, where POSIX gives no rules, a leading "!"
is left to the parser as before.

---
 coreutils/test.c |   10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

--- a/coreutils/test.c
+++ b/coreutils/test.c
@@ -999,6 +999,10 @@
 					argv[3] = NULL;
 					argv++;
 				}
+			} else {
+				/* 5 or more args: the parser handles a leading "!",
+				 * which binds tighter than -a and -o */
+				goto parse;
 			}
 		}
  check_negate:
@@ -1007,10 +1011,12 @@
 			negate ^= 1;
 			goto again;
 		}
+ parse:
+		/* Parse what is left after the special cases above */
+		args = argv;
+		res = !oexpr(check_operator(*args)) ^ negate;
 	}
 
-	res = !oexpr(check_operator(*args));
-
 	if (*args != NULL && *++args != NULL) {
 		/* Examples:
 		 * test 3 -lt 5 6
