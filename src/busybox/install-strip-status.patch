Don't print a stale errno when strip fails under install -s.
spawn_and_wait() returns -1 with errno set when strip cannot be run,
but strip's exit status when it runs and fails. install called
bb_simple_perror_msg("strip") in both cases, so after strip had
reported its own error, install added whatever reason errno happened
to hold, such as "No such file or directory". Keep that message for a
strip that cannot be run, and otherwise report strip's exit status, as
run-parts does.

---
 coreutils/install.c |    8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

--- a/coreutils/install.c
+++ b/coreutils/install.c
@@ -233,6 +233,7 @@
 			}
 			if (opts & OPT_STRIP) {
 				char *args[4];
+				int rc;
 				args[0] = (char*)"strip";
 				args[1] = (char*)"-p"; /* -p --preserve-dates */
 				args[2] = dest;
@@ -241,10 +242,13 @@
 				 * read-only, but strip must rewrite it. The mode
 				 * is set properly below. */
 				chmod(dest, 0600);
-				if (spawn_and_wait(args)) {
+				rc = spawn_and_wait(args);
+				if (rc < 0)
 					bb_simple_perror_msg("strip");
+				else if (rc > 0)
+					bb_error_msg("strip: exit status %u", rc & 0xff);
+				if (rc)
 					ret = EXIT_FAILURE;
-				}
 			}
 		}
 
