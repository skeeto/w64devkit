+
+/* Search line[start..end) for the regex, and set gl->matched_range
+ * to offsets from the line start. The text before start still counts
+ * for ^, \<, \b and the like (only for ^ without REG_STARTEND).
+ * With noteol, $ does not match at end. Returns 0 on a match. */
+static int regex_search(grep_list_data_t *gl, char *line,
+		unsigned start, unsigned end, int noteol)
+{
+#if !ENABLE_EXTRA_COMPAT
+	/* REG_NOTBOL too: BSD regexec matches ^ at rm_so without it */
+	int eflags = (noteol ? REG_NOTEOL : 0) | (start ? REG_NOTBOL : 0);
+# ifdef REG_STARTEND
+	gl->matched_range.rm_so = start;
+	gl->matched_range.rm_eo = end;
+	return regexec(&gl->compiled_regex, line, 1, &gl->matched_range,
+			eflags | REG_STARTEND);
+# else
+	char c = line[end];
+	int r;
+
+	line[end] = '\0';
+	r = regexec(&gl->compiled_regex, line + start, 1, &gl->matched_range,
+			eflags);
+	line[end] = c;
+	gl->matched_range.rm_so += start;
+	gl->matched_range.rm_eo += start;
+	return r;
+# endif
+#else
+	gl->compiled_regex.not_eol = noteol;
+	return re_search(&gl->compiled_regex, line, end,
+			start, /*range:*/ end - start,
+			&gl->matched_range) < 0;
+#endif
+}
+
+/* Find the first match at or after line[start], of a line of length
+ * len, which -w accepts: one not preceded or followed by a word
+ * character. Returns 0 on a match. */
+static int find_match(grep_list_data_t *gl, char *line,
+		unsigned start, unsigned len)
+{
+	while (regex_search(gl, line, start, len, 0) == 0) {
+		unsigned so = gl->matched_range.rm_so;
+		unsigned eo = gl->matched_range.rm_eo;
+		char c;
+
+		/* no -w, or -x which overrides it? */
+		if ((option_mask32 & (OPT_w | OPT_x)) != OPT_w)
+			return 0;
+		c = so ? line[so - 1] : ' ';
+		if (!isalnum(c) && c != '_') {
+			/* Try this match, then shorter ones at the same place:
+			 * "echo 'a bc' | grep -w 'a[^c]*'" matches "a" */
+			for (;;) {
+				c = line[eo];
+				if (!isalnum(c) && c != '_') {
+					gl->matched_range.rm_so = so;
+					gl->matched_range.rm_eo = eo;
+					return 0;
+				}
+				if (eo == so
+				 || regex_search(gl, line, so, eo - 1, 1) != 0
+				 || gl->matched_range.rm_so != so
+				) {
+					break;
+				}
+				eo = gl->matched_range.rm_eo;
+			}
+		}
+		/* Then those starting further on, even inside this one:
+		 * "echo 'ba a a' | grep -w 'a.a'" matches the second "a a" */
+		if (so == len)
+			break;
+		start = so + 1;
+	}
+	return 1;
+}
