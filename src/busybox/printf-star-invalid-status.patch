-static int get_width_prec(const char *str)
+static int get_width_prec(const char *str, int *conv_err)
 {
 	int v = bb_strtoi(str, NULL, 10);
 	if (errno) {
+		*conv_err |= errno;
 		bb_error_msg("invalid number '%s'", str);
 		v = 0;
 	}
@@ -401,7 +402,7 @@
 				++f;
 				++direc_length;
 				if (*argv)
-					field_width = get_width_prec(*argv++);
+					field_width = get_width_prec(*argv++, conv_err);
 			} else {
