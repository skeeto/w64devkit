Check the shred -s argument before processing any file.
The -s argument was parsed inside the loop, and only for a file longer
than 0 bytes, so an invalid size was accepted with status 0 when every
operand was empty, and otherwise rejected only after earlier files had
been processed. Parse and check it once, before the first file.

---
 coreutils/shred.c |   13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

--- a/coreutils/shred.c
+++ b/coreutils/shred.c
@@ -54,6 +54,7 @@
 int shred_main(int argc UNUSED_PARAM, char **argv)
 {
 	char *opt_s;
+	off_t opt_size = 0;
 	int rand_fd = rand_fd; /* for compiler */
 	int zero_fd;
 	int ret = EXIT_SUCCESS;
@@ -72,6 +73,11 @@
 	opt = getopt32(argv, "^" "fuzn:+vxs:" "\0" "-1"/*min 1 arg*/, &num_iter, &opt_s);
 	argv += optind;
 
+	if (opt & OPT_s) {
+		opt_size = BB_STRTOOFF(opt_s, NULL, 0); /* accepts oct/hex */
+		if (errno || opt_size < 0) bb_show_usage();
+	}
+
 	zero_fd = MINGW_SPECIAL(xopen)("/dev/zero", O_RDONLY);
 	if (num_iter != 0)
 		rand_fd = MINGW_SPECIAL(xopen)("/dev/urandom", O_RDONLY);
@@ -95,13 +101,8 @@
 			fd = xopen(fname, O_WRONLY);
 
 		if (fstat(fd, &sb) == 0 && sb.st_size > 0) {
-			off_t size = sb.st_size;
+			off_t size = (opt & OPT_s) ? opt_size : sb.st_size;
 
-			if (opt & OPT_s) {
-				size = BB_STRTOOFF(opt_s, NULL, 0); /* accepts oct/hex */
-				if (errno || size < 0) bb_show_usage();
-			}
-
 			for (i = 0; i < num_iter; i++) {
 				if (write_pass(rand_fd, fd, size, fname) != 0)
 					goto fail;
