Keep the options given in BC_ENV_ARGS. bc parses BC_ENV_ARGS and then
the command line with getopt32, meaning to OR the two sets of options
together in option_mask32, but getopt32 itself assigns option_mask32,
so the second call threw away -l, -q, -s and -w from BC_ENV_ARGS
(only -v worked, since it exits at once). Save the options before the
second call and combine them afterwards.

---
 miscutils/bc.c |    7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

--- a/miscutils/bc.c
+++ b/miscutils/bc.c
@@ -7099,9 +7099,11 @@
 	unsigned opts;
 	int i;
 
+	// getopt32 overwrites option_mask32: keep options from BC_ENV_ARGS
+	opts = option_mask32;
 	GETOPT_RESET();
 #if ENABLE_FEATURE_BC_LONG_OPTIONS
-	opts = option_mask32 |= getopt32long(argv, "wvsqli",
+	opts |= getopt32long(argv, "wvsqli",
 		"warn\0"              No_argument "w"
 		"version\0"           No_argument "v"
 		"standard\0"          No_argument "s"
@@ -7110,8 +7112,9 @@
 		"interactive\0"       No_argument "i"
 	);
 #else
-	opts = option_mask32 |= getopt32(argv, "wvsqli");
+	opts |= getopt32(argv, "wvsqli");
 #endif
+	option_mask32 = opts;
 	if (getenv("POSIXLY_CORRECT"))
 		option_mask32 |= BC_FLAG_S;
 
