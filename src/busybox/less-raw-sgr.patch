+#define is_cont(c) (unicode_status == UNICODE_ON && ((c) & 0xc0) == 0x80)
 
+/* Length of the SGR sequence at s, negative if it is unfinished
+ * (only at the end of a line still being read), or 0 if none. */
+static int sgr_len(const char *s)
+{
+	int n = 1;
+
+	if (!(option_mask32 & FLAG_R) || *s != '\033')
+		return 0;
+	if (s[n] == '[') {
+		while (isdigit(s[++n]) || s[n] == ';')
+			continue;
+		if (s[n] == 'm')
+			return n + 1;
+	}
+	return -n;
+}
+
+static int zero_width(const char *s)
+{
+	return *s && (sgr_len(s) || is_cont((unsigned char)*s));
+}
+
+/* Does the line, which ends at end, end with an SGR sequence? */
+static int ends_in_sgr(const char *line, const char *end)
+{
+	const char *esc = (option_mask32 & FLAG_R) ? strrchr(line, '\033') : NULL;
+	return esc && esc + sgr_len(esc) == end;
+}
