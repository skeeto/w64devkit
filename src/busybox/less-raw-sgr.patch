+static void print_line(const char *line, const char *hl, int sgr)
+{
+	size_t i = 0, n;
+	int on = 0;
+
+	while (line[i]) {
+		int k = sgr_len(line + i);
+		if (k > 0) {
+			/* a reset would end a highlight too */
+			printf("%.*s%s", k, line + i, on ? HIGHLIGHT : "");
+			sgr = 1;
+		}
+		if (k) {
+			i += abs(k);
+			continue;
+		}
+		if (hl && hl[i] != on) {
+			on = hl[i];
+			printf(on ? HIGHLIGHT : ESC"[27m");
