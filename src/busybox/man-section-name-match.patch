Match section names against whole entries of the section list.
is_section_name() found the name with strstr() and only checked that
the match ended at a colon, so the tail of an entry counted: "p"
matched "0p", which made "man p foo" search section p and "man x.p"
look for page x in section p, while "0" in a list such as "0p:1:0" was
rejected because its first match was inside "0p". Also require the
match to start at the beginning of the list or after a colon.

---
 miscutils/man.c |   13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

--- a/miscutils/man.c
+++ b/miscutils/man.c
@@ -293,10 +293,15 @@
 
 static int is_section_name(const char *sections, const char *str)
 {
-	const char *s = strstr(sections, str);
-	if (s) {
-		int l = strlen(str);
-		return (s[l] == ':' || s[l] == '\0');
+	const char *s = sections;
+	int l = strlen(str);
+
+	/* str must match whole entries, not the tail of one ("p" in "0p") */
+	while (l && (s = strstr(s, str)) != NULL) {
+		if ((s == sections || s[-1] == ':')
+		 && (s[l] == ':' || s[l] == '\0'))
+			return 1;
+		s++;
 	}
 	return 0;
 }
