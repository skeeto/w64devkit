--- a/win32/mingw.c
+++ b/win32/mingw.c
@@ -1202,6 +1202,16 @@
 #if !defined(_WIN64) && __MINGW64_VERSION_MAJOR >= 10
 # define localtime(t) _localtime64(t)
 #endif
+/*
+ * The runtime's localtime(), which returns NULL for a time it can't
+ * convert.  mingw_localtime() below substitutes the epoch instead, so
+ * callers that report out-of-range times as errors must use this.
+ */
+struct tm * FAST_FUNC localtime_or_null(const time_t *timep)
+{
+	return localtime(timep);
+}
+
 struct tm * FAST_FUNC mingw_localtime(const time_t *timep)
 {
 	struct tm *tm = localtime(timep);
