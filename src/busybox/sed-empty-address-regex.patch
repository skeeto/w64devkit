 		pos += (next+1);
@@ -1124,12 +1126,21 @@
 
 #define sed_puts(s, n) (puts_maybe_newline(s, G.nonstdout, &last_puts_char, n))
 
+/* Test an address regex, which becomes the last regex used */
+static int match_address(regex_t *regex, const char *pattern_space)
+{
+	if (regex == EMPTY_REGEX) {
+		regex = G.previous_regex_ptr;
+		if (!regex)
+			bb_simple_error_msg_and_die("no previous regexp");
+	}
+	G.previous_regex_ptr = regex;
+	return regexec(regex, pattern_space, 0, NULL, 0) == 0;
+}
+
 static int beg_match(sed_cmd_t *sed_cmd, const char *pattern_space)
 {
-	int retval = sed_cmd->beg_match && !regexec(sed_cmd->beg_match, pattern_space, 0, NULL, 0);
-	if (retval)
-		G.previous_regex_ptr = sed_cmd->beg_match;
-	return retval;
+	return sed_cmd->beg_match && match_address(sed_cmd->beg_match, pattern_space);
 }
 
