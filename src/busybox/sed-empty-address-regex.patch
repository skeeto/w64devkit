 } FIX_ALIASING;
 #define G (*(struct globals*)bb_common_bufsiz1)
+/* Marks an empty address regex (//), which stands for the last regex
+ * used, the one G.previous_regex_ptr points to when it is tested */
+#define EMPTY_REGEX ((regex_t *)&G.previous_regex_ptr)
 #define INIT_G() do { \
 	setup_common_bufsiz(); \
 	BUILD_BUG_ON(sizeof(G) > COMMON_BUFSIZE); \
@@ -408,13 +411,12 @@
