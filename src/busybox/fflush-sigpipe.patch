Treat a broken pipe found by fflush like one found by the other stdio
output functions. Those are wrapped so that a write to a pipe whose
reader has gone exits with status 141, as if killed by SIGPIPE, but
fflush was not, and on Windows output to a pipe is fully buffered, so
the write that fails is often the one done by fflush. bc and dc, which
flush after each statement and then check ferror, nearly always
printed "output error: Invalid argument" (the CRT's errno for
ERROR_NO_DATA) and exited with status 1, and applets that end with
fflush_stdout_and_exit() or fflush_all(), such as sort and wc, did the
same whenever their output was short enough to stay buffered until
then. Wrap fflush too. For fflush(NULL), which does not say which
stream failed, check stdout.

---
 include/mingw.h |    2 ++
 win32/winansi.c |   12 ++++++++++++
 2 files changed, 14 insertions(+)

--- a/include/mingw.h
+++ b/include/mingw.h
@@ -180,6 +180,7 @@
 size_t winansi_fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream) FAST_FUNC;
 int winansi_fputs(const char *str, FILE *stream) FAST_FUNC;
 int winansi_fputc(int c, FILE *stream) FAST_FUNC;
+int winansi_fflush(FILE *stream) FAST_FUNC;
 int winansi_vsnprintf(char *buf, size_t size, const char *format, va_list list) FAST_FUNC;
 int winansi_vfprintf(FILE *stream, const char *format, va_list list) FAST_FUNC;
 int winansi_printf(const char *format, ...) __attribute__((format (printf, 1, 2)));
@@ -197,6 +198,7 @@
 #define fwrite winansi_fwrite
 #define fputs winansi_fputs
 #define fputc winansi_fputc
+#define fflush winansi_fflush
 #if !defined(__USE_MINGW_ANSI_STDIO) || !__USE_MINGW_ANSI_STDIO
 #define vsnprintf(buf, size, ...) winansi_vsnprintf(buf, size,  __VA_ARGS__)
 #endif
--- a/win32/winansi.c
+++ b/win32/winansi.c
@@ -22,6 +22,7 @@
 #undef fprintf
 #undef fputs
 #undef fputc
+#undef fflush
 #undef putchar
 #undef fwrite
 #undef puts
@@ -948,6 +949,17 @@
 	return conv_fwriteCon(stream, s, 1) == EOF ? EOF : (unsigned char )c;
 }
 
+int FAST_FUNC winansi_fflush(FILE *stream)
+{
+	int ret;
+
+	/* fflush(NULL) doesn't say which stream failed: assume stdout */
+	SetLastError(0);
+	if ((ret=fflush(stream)) == EOF)
+		check_pipe(stream ? stream : stdout);
+	return ret;
+}
