+/* Quote for sh -c: wrap in '...' and turn each ' into '\'' */
+static char *sh_quote(const char *s)
+{
+	char *r = xmalloc(4 * strlen(s) + 3);
+	char *p = r;
+
+	*p++ = '\'';
+	for (; *s; s++) {
+		if (*s == '\'') {
+			memcpy(p, "'\\''", 4);
+			p += 4;
+		} else {
+			*p++ = *s;
+		}
+	}
+	*p++ = '\'';
+	*p = '\0';
+	return r;
+}
