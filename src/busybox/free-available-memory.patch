Show the memory Windows reports as available in free's available column.
On Windows parse_meminfo() set available_kb to zero, so the available
column was always 0 although Windows knows the value. Fill it in from
the available physical memory reported by GlobalMemoryStatusEx(), the
counterpart of MemAvailable.

---
 procps/free.c |    9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

--- a/procps/free.c
+++ b/procps/free.c
@@ -107,8 +107,15 @@
 #else
 static unsigned int parse_meminfo(struct globals *g)
 {
-	g->cached_kb = g->available_kb = g->reclaimable_kb = 0;
+	MEMORYSTATUSEX status;
 
+	g->cached_kb = g->reclaimable_kb = 0;
+
+	/* The counterpart of MemAvailable */
+	status.dwLength = sizeof(status);
+	g->available_kb = GlobalMemoryStatusEx(&status) ?
+						status.ullAvailPhys >> 10 : 0;
+
 	return 1;
 }
 #endif
