 findutils/xargs.c |   12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

--- a/findutils/xargs.c
+++ b/findutils/xargs.c
@@ -772,6 +772,7 @@
 	int delta = 0;
 	int quote = TRUE;
 	char *old_buf = NULL;
+	size_t fixed_chars = 0;
 #endif
 #if ENABLE_FEATURE_XARGS_SUPPORT_ZERO_TERM \
  || ENABLE_FEATURE_XARGS_SUPPORT_REPL_STR
@@ -933,6 +934,13 @@
 #endif
 
 	initial_idx = G.idx;
+#if ENABLE_PLATFORM_MINGW32
+	/* The fixed args are on the Windows command line too */
+	if (quote) {
+		for (i = 0; i < initial_idx; i++)
+			fixed_chars += quote_len(G.args[i]) + 1;
+	}
+#endif
 	while (1) {
 		char *rem;
 #if ENABLE_PLATFORM_MINGW32
