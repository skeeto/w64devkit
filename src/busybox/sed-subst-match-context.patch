 1 file changed, 27 insertions(+), 2 deletions(-)

--- a/editors/sed.c
+++ b/editors/sed.c
@@ -844,6 +844,32 @@
 	}
 }
 
+/* Find the next match in the rest of the pattern space, from line on,
+ * with offsets relative to line. Where possible, search the whole
+ * pattern space starting at line, so that \<, \b and the like see
+ * the text before line. Either way, ^ does not match at line. */
+static int regexec_rest(regex_t *regex, const char *pattern_space, const char *line)
+{
+#if defined(REG_STARTEND)
+	int i, r, ofs = line - pattern_space;
+
+	G.regmatch[0].rm_so = ofs;
+	G.regmatch[0].rm_eo = ofs + strlen(line);
+	r = regexec(regex, pattern_space, 10, G.regmatch, REG_STARTEND | REG_NOTBOL);
+	if (r == 0) {
+		for (i = 0; i < 10; i++) {
+			if (G.regmatch[i].rm_so != -1) {
+				G.regmatch[i].rm_so -= ofs;
+				G.regmatch[i].rm_eo -= ofs;
+			}
+		}
+	}
+	return r;
+#else
+	return regexec(regex, line, 10, G.regmatch, REG_NOTBOL);
+#endif
+}
+
 static int do_subst_command(sed_cmd_t *sed_cmd, char **line_p)
 {
 	char *line = *line_p;
