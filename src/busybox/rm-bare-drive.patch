Refuse to remove a bare drive operand such as C:, which names the
drive's current directory, just as rm already refuses C:. and . itself.

---
 coreutils/rm.c |    5 +++++
 1 file changed, 5 insertions(+)

--- a/coreutils/rm.c
+++ b/coreutils/rm.c
@@ -61,6 +61,11 @@
 		do {
 			const char *base = bb_get_last_path_component_strip(*argv);
 
+#if ENABLE_PLATFORM_MINGW32
+			/* a bare drive "X:" is the same directory as "X:." */
+			if (has_dos_drive_prefix(base) && base[2] == '\0')
+				base = ".";
+#endif
 			if (DOT_OR_DOTDOT(base)) {
 				bb_simple_error_msg("can't remove '.' or '..'");
 			} else if (remove_file(*argv, flags) >= 0) {
