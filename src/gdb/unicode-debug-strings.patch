--- a/gdb/nat/windows-nat.h
+++ b/gdb/nat/windows-nat.h
@@ -403,6 +403,17 @@
 
 extern BOOL wait_for_debug_event (DEBUG_EVENT *event, DWORD timeout);
 
+/* If true, and WaitForDebugEventEx is available (Windows 10 and
+   later), wait_for_debug_event uses it instead of WaitForDebugEvent.
+   That makes the system report OutputDebugStringW strings as Unicode,
+   with fUnicode set in the OUTPUT_DEBUG_STRING_EVENT, rather than
+   converting them to the inferior's ANSI code page, which loses any
+   character the code page cannot represent.  Only set this if the
+   client's handle_output_debug_string handles Unicode strings.
+   Defaults to false.  */
+
+extern bool unicode_debug_strings;
+
 /* Wrappers for CreateProcess.  These exist primarily so that the
    "disable randomization" feature can be implemented in a single
    place.  */
