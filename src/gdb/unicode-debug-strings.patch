 static GetThreadDescription_ftype *GetThreadDescription;
 
+/* Available on Windows 10 and later.  */
+#define WaitForDebugEventEx dyn_WaitForDebugEventEx
+typedef BOOL WINAPI (WaitForDebugEventEx_ftype) (LPDEBUG_EVENT, DWORD);
+static WaitForDebugEventEx_ftype *WaitForDebugEventEx;
+
+/* See nat/windows-nat.h.  */
+bool unicode_debug_strings;
+
 InitializeProcThreadAttributeList_ftype *InitializeProcThreadAttributeList;
 UpdateProcThreadAttribute_ftype *UpdateProcThreadAttribute;
 DeleteProcThreadAttributeList_ftype *DeleteProcThreadAttributeList;
@@ -926,7 +934,11 @@
 BOOL
 wait_for_debug_event (DEBUG_EVENT *event, DWORD timeout)
 {
-  BOOL result = WaitForDebugEvent (event, timeout);
+  /* WaitForDebugEventEx behaves like WaitForDebugEvent, except that it
+     opts in to receiving OutputDebugStringW strings as Unicode.  */
+  BOOL result = (unicode_debug_strings && WaitForDebugEventEx != nullptr
+		 ? WaitForDebugEventEx (event, timeout)
+		 : WaitForDebugEvent (event, timeout));
   if (result)
     last_wait_event = *event;
   return result;
@@ -1168,6 +1180,7 @@
 #endif
