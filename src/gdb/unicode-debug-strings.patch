 }
 
+/* Read the null-terminated UTF-16 string at ADDR in the inferior, as
+   reported for OutputDebugStringW when fUnicode is set, and convert it
+   to the host character set.  Returns nullptr on error.  */
+
+static gdb::unique_xmalloc_ptr<char>
+read_unicode_debug_string (CORE_ADDR addr)
+{
+  gdb::unique_xmalloc_ptr<gdb_byte> buffer;
+  int bytes_read;
+
+  if (target_read_string (addr, -1, 2, 1024, &buffer, &bytes_read) != 0)
+    return nullptr;
+
+  /* Do not convert the terminating null character.  */
+  if (bytes_read >= 2
+      && buffer.get ()[bytes_read - 2] == 0
+      && buffer.get ()[bytes_read - 1] == 0)
+    bytes_read -= 2;
+
+  try
+    {
+      auto_obstack output;
+      convert_between_encodings ("UTF-16LE", host_charset (),
+				 buffer.get (), bytes_read, 2,
+				 &output, translit_char);
+      obstack_1grow (&output, '\0');
+      return make_unique_xstrdup ((const char *) obstack_base (&output));
+    }
+  catch (const gdb_exception_error &)
+    {
+      return nullptr;
+    }
+}
+
 /* See nat/windows-nat.h.  */
 
