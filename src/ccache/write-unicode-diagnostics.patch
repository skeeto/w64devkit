From 481f2fa951bbfb24048a255cfee48c197dce5a86 Mon Sep 17 00:00:00 2001
From: Peter0x44 <peter0x44@disroot.org>
Date: Thu, 13 Aug 2026 04:00:01 -0500
Subject: [PATCH 2/2] fix: Write Unicode diagnostics with WriteConsoleW

Windows console output currently uses the byte-oriented file descriptor
API. This differs from GCC's direct console output, which converts
non-ASCII UTF-8 text to UTF-16 and writes it with WriteConsoleW.

Use the same approach whenever diagnostics are replayed to a real
Windows console, regardless of whether colors are stripped, translated
to Win32 attributes, or left as ANSI for a VT-enabled console. Decode
UTF-8 explicitly, convert supplementary characters to surrogate pairs,
and use WriteConsoleW for text containing non-ASCII characters.

Keep the existing byte-oriented path for ASCII, invalid UTF-8, and
redirected output. This prevents diagnostics containing characters
outside the active console code page from becoming mojibake when they
pass through ccache. The conversion strategy is based on GCC's MinGW
console writer in gcc/pretty-print.cc.
---
 src/ccache/core/common.cpp |  108 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 108 insertions(+)

--- a/src/ccache/core/common.cpp
+++ b/src/ccache/core/common.cpp
@@ -28,8 +28,11 @@
 #include <ccache/util/path.hpp>
 #include <ccache/util/tokenizer.hpp>
 
+#include <algorithm>
 #include <charconv>
 #include <cstdint>
+#include <limits>
+#include <utility>
 
 using IncludeDelimiter = util::Tokenizer::IncludeDelimiter;
 
@@ -175,6 +178,87 @@
   }
   return mode;
 }
+
+std::optional<std::pair<std::uint32_t, size_t>>
+decode_utf8_character(std::string_view text)
+{
+  const auto byte = [&text](size_t pos) {
+    return static_cast<unsigned char>(text[pos]);
+  };
+  const auto continuation = [&byte, &text](size_t pos) {
+    return pos < text.size() && (byte(pos) & 0xc0) == 0x80;
+  };
+
+  if (text.empty()) {
+    return std::nullopt;
+  }
+
+  std::uint32_t codepoint;
+  size_t length;
+  if (byte(0) < 0x80) {
+    return std::pair{byte(0), size_t{1}};
+  } else if (byte(0) >= 0xc2 && byte(0) <= 0xdf) {
+    codepoint = byte(0) & 0x1f;
+    length = 2;
+  } else if (byte(0) >= 0xe0 && byte(0) <= 0xef) {
+    codepoint = byte(0) & 0x0f;
+    length = 3;
+  } else if (byte(0) >= 0xf0 && byte(0) <= 0xf4) {
+    codepoint = byte(0) & 0x07;
+    length = 4;
+  } else {
+    return std::nullopt;
+  }
+
+  for (size_t i = 1; i < length; ++i) {
+    if (!continuation(i)) {
+      return std::nullopt;
+    }
+    codepoint = (codepoint << 6) | (byte(i) & 0x3f);
+  }
+
+  if ((length == 3 && codepoint < 0x800) || (length == 4 && codepoint < 0x10000)
+      || (codepoint >= 0xd800 && codepoint <= 0xdfff) || codepoint > 0x10ffff) {
+    return std::nullopt;
+  }
+  return std::pair{codepoint, length};
+}
+
+std::optional<std::wstring>
+utf8_to_utf16(std::string_view text)
+{
+  if (text.empty()
+      || std::all_of(
+        text.begin(), text.end(), [](unsigned char c) { return c < 0x80; })) {
+    return std::nullopt;
+  }
+
+  size_t utf16_size = 0;
+  for (size_t pos = 0; pos < text.size();) {
+    auto decoded = decode_utf8_character(text.substr(pos));
+    if (!decoded) {
+      return std::nullopt;
+    }
+    utf16_size += decoded->first <= 0xffff ? 1 : 2;
+    pos += decoded->second;
+  }
+
+  std::wstring result;
+  result.reserve(utf16_size);
+  for (size_t pos = 0; pos < text.size();) {
+    auto decoded = *decode_utf8_character(text.substr(pos));
+    auto [codepoint, length] = decoded;
+    if (codepoint <= 0xffff) {
+      result.push_back(static_cast<wchar_t>(codepoint));
+    } else {
+      codepoint -= 0x10000;
+      result.push_back(static_cast<wchar_t>(0xd800 + (codepoint >> 10)));
+      result.push_back(static_cast<wchar_t>(0xdc00 + (codepoint & 0x3ff)));
+    }
+    pos += length;
+  }
+  return result;
+}
 #endif
 
 // Search for the first match of the following regular expression:
@@ -213,6 +297,26 @@
 void
 write_console_data(int fd, std::string_view data)
 {
+  HANDLE handle = reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+  DWORD mode;
+  if (GetConsoleMode(handle, &mode)) {
+    if (auto utf16 = utf8_to_utf16(data)) {
+      size_t pos = 0;
+      while (pos < utf16->size()) {
+        DWORD count = static_cast<DWORD>(std::min<size_t>(
+          utf16->size() - pos, std::numeric_limits<DWORD>::max()));
+        DWORD written;
+        if (!WriteConsoleW(
+              handle, utf16->data() + pos, count, &written, nullptr)
+            || written == 0) {
+          throw core::Error("Failed to write Unicode text to console");
+        }
+        pos += written;
+      }
+      return;
+    }
+  }
+
   util::throw_on_error<core::Error>(
     util::write_fd(fd, data.data(), data.length()),
     FMT("Failed to write to fd {}: ", fd));
@@ -447,9 +551,13 @@
   }
 #endif
 
+#ifdef _WIN32
+  write_console_data(fd, text_to_send);
+#else
   util::throw_on_error<core::Error>(
     util::write_fd(fd, text_to_send.data(), text_to_send.length()),
     FMT("Failed to write to fd {}: ", fd));
+#endif
 }
 
